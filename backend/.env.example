# ============================================================================
# SolaRun Backend Configuration
# Copy this to .env and fill in your values
# ============================================================================

# ============================================================================
# Server
# ============================================================================
PORT=3001

# ============================================================================
# Supabase Configuration
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# Solana Configuration (Phase 1.7)
# ============================================================================

# RPC Endpoint (devnet for development)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# Admin keypair for signing refund transactions
# Generate with: solana-keygen new --outfile admin-keypair.json
ADMIN_KEYPAIR_PATH=./admin-keypair.json

# Smart Contract Program ID (from anchor deploy)
SOLARUN_PROGRAM_ID=5GyrTPkwRdZEMj9fQfANqiWZqGU7FxAJ2WNe3RuVmZU7

# Vault PDA Address (derived from smart contract)
VAULT_ADDRESS=9aQ2pU9vK3xL8mN5bR2cF7gH1jK4qO8pZ9vX2yA3bC4

# ============================================================================
# MQTT Configuration
# ============================================================================

# MQTT Broker URL (local or HiveMQ cloud)
MQTT_BROKER_URL=mqtt://localhost:1883
# or for HiveMQ cloud:
# MQTT_BROKER=broker.hivemq.com
# MQTT_PORT=8883
# MQTT_USERNAME=solarun_backend
# MQTT_PASSWORD=your_password_here

# MQTT Topics
MQTT_TOPIC=race/checkpoint
MQTT_CONFIG_TOPIC=race/config

# ============================================================================
# Refund Scheduler Configuration (Phase 1.7)
# ============================================================================

# Cron schedule for refund processing
# Default: every 1 minute (*/1 * * * *)
# Examples:
#   */1 * * * * = every 1 minute
#   0 */5 * * * = every 5 minutes
#   0 0 * * *   = every day at midnight
REFUND_SCHEDULER_INTERVAL=*/1 * * * *

# ============================================================================
# Logging & Debug
# ============================================================================

# Log level
LOG_LEVEL=info

# Enable debug blockchain logging
DEBUG_BLOCKCHAIN=false

# ============================================================================
# Setup Instructions
# ============================================================================
# 
# 1. Create admin keypair:
#    solana-keygen new --outfile admin-keypair.json
#
# 2. Get Supabase credentials:
#    Dashboard → Settings → API → SUPABASE_URL and service role key
#
# 3. Get Solana RPC:
#    For devnet: https://api.devnet.solana.com
#
# 4. Deploy smart contract:
#    cd contracts && anchor deploy --provider.cluster devnet
#    Copy program ID to SOLARUN_PROGRAM_ID
#
# 5. Fund admin wallet on devnet:
#    solana airdrop 2 --url devnet  (or use faucet)
